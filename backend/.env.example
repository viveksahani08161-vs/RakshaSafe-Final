# RakshaSafe backend environment configuration (development)
# Copy to .env and adjust as needed.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/rakshasafe

# JWT authentication
JWT_SECRET=rakshasafe-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Python AI service (risk assessment). No API key required.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# HTTP logging level (combined / common / dev / short / tiny)
LOG_LEVEL=dev

# External nearby-places provider (Google Places API, New). Server-side only:
# never put this key in frontend code or frontend .env files.
# Disabled by default — the app works fully on RakshaSafe database resources.
GOOGLE_PLACES_API_KEY=
NEARBY_EXTERNAL_ENABLED=false
NEARBY_EXTERNAL_TIMEOUT_MS=8000
NEARBY_RADIUS_KM=25