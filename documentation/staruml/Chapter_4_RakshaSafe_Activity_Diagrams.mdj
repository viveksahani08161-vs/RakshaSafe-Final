                  },
                  "points": "298.0:1908.0;457.4:1842.0"
                }
              ]
            }
          ]
        },
        {
          "_type": "UMLActivity",
          "_id": "9c7861896213fa5222bc26537be2ae57",
          "_parent": {
            "$ref": "e7b16ae4d1a5407fbac56dcace8cd83d"
          },
          "name": "Flowchart 4.2.14: Admin Masters",
          "nodes": [
            {
              "_type": "UMLInitialNode",
              "_id": "ccad1513b8dd6c58f8608df503c35028",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Start"
            },
            {
              "_type": "UMLAction",
              "_id": "f6d8c588d6a52cf4563a546a2e9f8b9b",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Admin master modules: users,\nfacilities, rescue teams (+members),\nemergency contacts, unsafe reports,\nreports"
            },
            {
              "_type": "UMLAction",
              "_id": "8a4bf66b4612d6138d83e779b5d4a84f",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Users: list (name/email/phone -\npasswords never searchable); detail loads\na wide activity bundle; PATCH name /\nemail/phone/language/role/isActive"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "2ac2420d6246d150d246a5778be59cf3",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Self-protection / last-admin\nrule applies?"
            },
            {
              "_type": "UMLAction",
              "_id": "b2879c384a8b7b295158a021d1ecbef8",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Blocked 400: 'You cannot change your\nown admin role.' / 'You cannot delete\nyour own administrator account.' /\n'Cannot demote the last active admin.'"
            },
            {
              "_type": "UMLAction",
              "_id": "bb708200ecd78e6146b18e5b63fc2f7f",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "DELETE user = real deletion: cascades\nowned updates, assignments, notifications,\ncontacts, incidents, unsafe reports,\nreports, team membership"
            },
            {
              "_type": "UMLAction",
              "_id": "a82263d52fef3f6cba52432e23a0cba0",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Locations / risk assessments deleted\nonly if orphaned (still referenced\nrecords retained)"
            },
            {
              "_type": "UMLAction",
              "_id": "656d80ee14b84105985cb8a3161f37ce",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Facilities & teams: CRUD + isActive\n(gates operational / active counts);\nmembers add/remove (drives responder\nvisibility via team membership)"
            },
            {
              "_type": "UMLAction",
              "_id": "13ed77e1844aa67796720daf386a48b6",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Emergency contacts: list all, edit,\ndelete (per-user view)"
            },
            {
              "_type": "UMLAction",
              "_id": "dfaf6593f5c807eaac70661f4a5c0eba",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Unsafe reports: list, verify (PATCH\nisVerified), delete - submissions\nalways start unverified"
            },
            {
              "_type": "UMLAction",
              "_id": "8604de7319118395ed4a9e14fe9c9385",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Reports: generate, list, get, export,\ndelete"
            },
            {
              "_type": "UMLAction",
              "_id": "11c9e0a647753b5cf8ef881746ef6e63",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "Every admin action writes AdminLogs\n(admin, target, time, requesting IP)"
            },
            {
              "_type": "UMLActivityFinalNode",
              "_id": "04a156cc6feb2252027bd7c31e52e98b",
              "_parent": {
                "$ref": "9c7861896213fa5222bc26537be2ae57"
              },
              "name": "End"
            }
          ],
