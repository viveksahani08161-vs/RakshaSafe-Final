              "_parent": {
                "$ref": "99cced5b87787ef0a75afccc92659eab"
              },
              "name": "On load (parallel):\nGET /api/incidents (200 max)\nGET /api/emergency-contacts (100 max)"
            },
            {
              "_type": "UMLAction",
              "_id": "d7aff95604a9af0b452e64133c6b8cd3",
              "_parent": {
                "$ref": "99cced5b87787ef0a75afccc92659eab"
              },
              "name": "Then, non-blocking: device GPS\nstate tile (loading/idle/available/\ndenied/timeout/unavailable/unsupported)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "32c7618aa5669c10a0cfa1be07c83bf6",
              "_parent": {
                "$ref": "99cced5b87787ef0a75afccc92659eab"
              },
              "name": "Incidents / contacts\nfailed to load?"
            },
