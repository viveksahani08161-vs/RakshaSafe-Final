        {
          "_type": "UMLActivity",
          "_id": "3d268d57208f39c6c579c8f404534ca2",
          "_parent": {
            "$ref": "e7b16ae4d1a5407fbac56dcace8cd83d"
          },
          "name": "Flowchart 4.2.4: SOS Creation",
          "nodes": [
            {
              "_type": "UMLInitialNode",
              "_id": "9e85dd59a54ffefc49ddab658629831a",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Start"
            },
            {
              "_type": "UMLAction",
              "_id": "4ae621520f06d55a32def7d675aff8fd",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Step Details:\ntype (Safety|Disaster), category,\ndescription (up to 2000), priority\n(LOW..CRITICAL)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "fb9931f7116fe949f3196b8e2eaf647e",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Details valid?"
            },
            {
              "_type": "UMLAction",
              "_id": "243b93ee23495133ca003ea95ff46093",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Hardcoded validation: 'Select Safety\nor Disaster.' / 'Select a category.' /\n'Describe what is happening.'"
            },
            {
              "_type": "UMLAction",
              "_id": "3abc98b37daf8339ebf9c5ef9eb3e311",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Step Location:\n'Use device location' or\n'Continue without location'"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "c2bc2d28ceb66bc0936e6b5e06f8cdfa",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "GPS outcome?"
            },
            {
              "_type": "UMLAction",
              "_id": "7cc3b2d3d1655b75ba1ed9001a80aace",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "available: capture lat,lng\n+/-N m; nearby section loads\n(25 km, grouped)"
            },
            {
              "_type": "UMLAction",
              "_id": "6d2db08dd8b39b8a5f046d23d910899d",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "denied/timeout/unavailable/\nunsupported: outcome alert +\nRetry / Allow location button"
            },
            {
              "_type": "UMLAction",
              "_id": "b8a0e834db6583a4e15177ee03baa884",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Skipped: 'No coordinates will be\nattached' - no false location\nis ever assumed"
            },
            {
              "_type": "UMLMergeNode",
              "_id": "9e7b8587315daa1c9b6d07e6f04c9752",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Merge"
            },
            {
              "_type": "UMLAction",
              "_id": "7cef3e9c1852da4307a3da39a6988956",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Step Review: summary rows Type /\nCategory / Priority / Details /\nLocation; 'Not provided, no\ncoordinates attached.' when absent"
            },
            {
              "_type": "UMLAction",
              "_id": "367e3ec98a14db8dbdcdf4efaac76e6e",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "'Review emergency request' is\ndisabled while acquiring or until an\nexplicit choice (outcome or skipped)"
            },
            {
              "_type": "UMLAction",
              "_id": "854913a413709369a1e237a11997dddd",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "POST /api/incidents\n(type, category, description,\npriority, location?)"
            },
            {
              "_type": "UMLAction",
              "_id": "7c742892e65bd9f7c5941a1de68c50ac",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "location key is omitted entirely\nwhen skipped - zero coordinates\nare never invented"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "2634f4a4cc198be7d9152a4f12d90675",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Submission succeeds?"
            },
            {
              "_type": "UMLAction",
              "_id": "6fe3d7a25b4158d836a4c8f6a863ce72",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Server: userId from JWT; status\nforced REPORTED; creates Location\nif given; recordEventSafe inc event,\nbest-effort; rate limit 10/min"
            },
            {
              "_type": "UMLAction",
              "_id": "48ee2e2d35a1060af4aedae6ce340a72",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "'Submission failed': message shown;\nstay on Review to retry"
            },
            {
              "_type": "UMLAction",
              "_id": "d8cc2d3bea11f0cee737222464d38657",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "Done: 'SOS recorded' + Reference /\nCategory / Priority / Recorded +\ndisclaimer (no dispatch guarantee);\nGo to dashboard / Report another"
            },
            {
              "_type": "UMLActivityFinalNode",
              "_id": "439be3ddf5c5874191220a7935ad6935",
              "_parent": {
                "$ref": "3d268d57208f39c6c579c8f404534ca2"
              },
              "name": "End"
            }
          ],
