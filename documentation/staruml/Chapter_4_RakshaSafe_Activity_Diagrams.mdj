              "_parent": {
                "$ref": "99cced5b87787ef0a75afccc92659eab"
              },
              "name": "ErrorState with Retry; contacts tile\nshows a dash with a 'Try again' warning"
            },
            {
              "_type": "UMLAction",
              "_id": "52e636791272275a6053e8628c06a5f0",
              "_parent": {
                "$ref": "99cced5b87787ef0a75afccc92659eab"
              },
              "name": "Render welcome hero (SOS button +\nquick-access tiles: contacts, resources,\nreport-unsafe) + stat tiles"
            },
