          "name": "Flowchart 4.2.6: Emergency Contacts",
          "nodes": [
            {
              "_type": "UMLInitialNode",
              "_id": "e0ab8b04a08f8b93ae36192e60665a56",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Start"
            },
            {
              "_type": "UMLAction",
              "_id": "2f2b6491f3e32c38a0aefdd93d4cb7bd",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "GET /api/emergency-contacts\n(capped 100): cards with name,\nrelationship, tel/mailto links,\nSMS / Email / no-auto-alerts badge"
            },
            {
              "_type": "UMLAction",
              "_id": "f2a930bc7217ebd7868360cea592c7d4",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Add / Edit form: name, phone,\nemail (opt), relationship (opt),\nnotifyViaSms (default true),\nnotifyViaEmail (default false),\nisPrimary (default false)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "49e9d2f456ac89173950b8d9e50bd29d",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Server validation passes?"
            },
            {
              "_type": "UMLAction",
              "_id": "7f46478b8b1aa119b0e4c0acd6cb94b4",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Per-field errors mapped to inputs:\nname 2-100, valid phone (normalized),\nvalid email, booleans true/false only"
            },
            {
              "_type": "UMLAction",
              "_id": "32094170c91ae836296b6e5aa35fec4f",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "POST /api/emergency-contacts or\nPATCH /:id (owner always from JWT)"
            },
            {
              "_type": "UMLAction",
              "_id": "1e2b3ab3f3af0c721bddb527c2070152",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Other user's id => scoped lookup\n{ _id, userId } => 404 'Contact\nnot found.' - never 403"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "df767a06d397369d1283dd56c90fbb6c",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "isPrimary?"
            },
            {
              "_type": "UMLAction",
              "_id": "115d9003886f1e6c7461bf7a196dca2f",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Mark as primary contact\n(badge shown; primary selects alert\npreference)"
            },
            {
              "_type": "UMLAction",
              "_id": "63254fad825e89dc342c39c75b5eb732",
              "_parent": {
                "$ref": "00e6b8282a8045514f2e8754e59eb891"
              },
              "name": "Delete => danger dialog =>\nDELETE /:id"
            },
