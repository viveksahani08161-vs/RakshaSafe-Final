              "_type": "UMLAction",
              "_id": "37e95b6733ac784c04e52180e26e851c",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "List card: category, severity badge,\nVerified / Pending badge, location + 4-dp\ncoords + accuracy; Edit (optional location\nreplacement) / Delete"
