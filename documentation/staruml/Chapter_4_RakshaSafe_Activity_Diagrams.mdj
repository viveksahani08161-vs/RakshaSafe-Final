              "_id": "40df4b378c41b563acca4a882e1da904",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "Field errors shown; submit disabled\nwhile GPS acquiring"
            },
            {
              "_type": "UMLAction",
              "_id": "4ab549eea807bcc37fa5dd825fdb275e",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "POST /api/unsafe-reports\n(rate limited 10/min)"
            },
