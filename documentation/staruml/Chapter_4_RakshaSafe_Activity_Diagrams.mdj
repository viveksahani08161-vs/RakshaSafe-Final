            },
            {
              "_type": "UMLAction",
              "_id": "cc921bdf2749afd3df49d03444034a55",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "GET /admin/incidents?page&limit(<=50)\n&status&priority&type&search (debounced;\nsearch matches category or description,\nregex-escaped)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "c77d60307d23a24adb498a69a45bde05",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Filters valid?"
            },
            {
              "_type": "UMLAction",
              "_id": "f2561dc80093c8cb5dac4d42603b4c5e",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "400: 'Status must be one of: ...' /\n'Priority must be one of: ...' /\n'Type must be Safety or Disaster.'"
            },
            {
              "_type": "UMLAction",
              "_id": "a6cc2b8c1134c01dae3b2b03a676b878",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Table: Category / Type / Priority /\nStatus / Reported / View ->\n/admin/incidents/:id"
            },
            {
              "_type": "UMLAction",
              "_id": "88977e251401813038e63f237c4560e6",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Detail: PATCH /admin/incidents/:id/status\n{ status, comment? <=500 }"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "91aa4c1d41105947233c4915e51fdda8",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Transition allowed?\nREPORTED->ACKNOWLEDGED|CANCELLED ...\nRESOLVED->CLOSED; CLOSED/CANCELLED\nterminal"
            },
            {
              "_type": "UMLAction",
              "_id": "2398a08020d2d2958647fb95eba36c79",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "400: 'Cannot move from X to Y.\nAllowed: A, B.' or 'Incident is X;\nits status can no longer change.'"
            },
            {
              "_type": "UMLAction",
              "_id": "07d9b64a61ef35f065e53c43ed7a372a",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Save incident FIRST, then IncidentUpdate\nhistory row + AdminLog (status update,\nIP) + owner notified (best-effort)"
            },
            {
              "_type": "UMLAction",
              "_id": "ad8312dd5fcf217458c9fc917d6865cc",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Assignment: POST /admin/incidents/:id/\nassignments { teamId, notes? } - team\noptions from active teams only"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "4ba0cbd6a3dc1931ff9c174adc093c40",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Team active & no duplicate\nactive assignment?"
            },
            {
              "_type": "UMLAction",
              "_id": "fa2e3334ac18a77a76932a73b98d29e0",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "400 'Rescue team is not active.' /\n409 'This team already has an active\nassignment for the incident.' / 404"
            },
            {
              "_type": "UMLAction",
              "_id": "771e27d26e043890292f885109a8a8d8",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Create ASSIGNED assignment (assignedBy\n= admin); incident status NOT changed\n(must advance by hand); log create +\nnotify incident.assigned:teamName"
            },
            {
              "_type": "UMLAction",
              "_id": "97587960959c5f84415f97926c1e4f87",
              "_parent": {
                "$ref": "41b3da83881143698f79b9f7d6d41660"
              },
              "name": "Assignment status PATCH /admin/\nassignments/:id (ASSIGNED->EN_ROUTE->\nON_SCENE->COMPLETED | CANCELLED);\nlogs assignment update; owner not notified"
            },
            {
              "_type": "UMLActivityFinalNode",
