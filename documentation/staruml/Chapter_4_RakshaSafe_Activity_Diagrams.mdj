          "_parent": {
            "$ref": "e7b16ae4d1a5407fbac56dcace8cd83d"
          },
          "name": "Flowchart 4.2.10: Notifications",
          "nodes": [
            {
              "_type": "UMLInitialNode",
              "_id": "4dfbcb1872fc3b4c2d6cb048d826c99a",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "Start"
            },
            {
              "_type": "UMLAction",
              "_id": "bf04e79d3e49ea73cdd3789829e7a8cb",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "GET /api/notifications (own incidents\nonly, newest first, limit 100; contact\nnames resolved from own contacts)"
            },
            {
              "_type": "UMLAction",
              "_id": "ca902ec9a3a09828a5661e27f23d0d95",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "Event label parsed from providerResponse\n(e.g. in-app:incident.status.changed:\nREPORTED->ACKNOWLEDGED); unknown labels\nfall back - never invented"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "3815eea3352f86b20c713f2e42b271e3",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "Channel?"
            },
            {
              "_type": "UMLAction",
              "_id": "ba6d6ee4a2fd112dac5463e52fdf3015",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "In-App: status DELIVERED - the app\nitself is the in-app provider, so\nstorage + serving IS delivery"
            },
            {
              "_type": "UMLAction",
              "_id": "1d10d3fb661f01f478d8b9c9a9c3b79f",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "Email / SMS / WhatsApp: status badge\n(SENT / QUEUED / FAILED)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "549ff011a76a65521918f94cda59c19a",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "status = NOT_CONFIGURED?"
            },
            {
              "_type": "UMLAction",
              "_id": "f98b4ad4871a9367d2e3bfad018d9b7a",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "NOT CONFIGURED badge + 'no provider\nconfigured' note (contact channels -\nnever rendered as sent)"
            },
            {
              "_type": "UMLAction",
              "_id": "7e985f54b969c07f32edeb046ba2529b",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "Unread = gold border/dot via local\ncursor 'rakshasafe.notifications.seen';\n'Mark all read' writes timestamp"
            },
            {
              "_type": "UMLAction",
              "_id": "0595aaf789d5cb066091881d411b973c",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "Click -> 'Incident update' context /\nlink to incident (responder list filters\nto In-App only for privacy)"
            },
            {
              "_type": "UMLActivityFinalNode",
              "_id": "1d96f3a86a52aa1fcb5eb39bfea1548b",
              "_parent": {
                "$ref": "efc588e45f07865edfc4a69ef99c9677"
              },
              "name": "End"
            }
