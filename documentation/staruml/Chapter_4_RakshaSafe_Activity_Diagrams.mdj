              },
              "name": "Start"
            },
            {
              "_type": "UMLAction",
              "_id": "9eabc7c0cc93f41e1474677864bca40f",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Resources page - three independent\nsections: Nearby facilities (OSM) /\nRegistered rescue teams / Stored\nemergency facilities"
            },
            {
              "_type": "UMLAction",
              "_id": "c526ccbe32851478f2f241a2bf8a9d5b",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Nearby: 'Use my location' ->\nrequestDeviceLocation()"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "4018a338f7c4f75763bdc7cafc67b348",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "GPS outcome?"
            },
            {
              "_type": "UMLAction",
              "_id": "37a681cbf0d27344d29af8240653e6c3",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Outcome error key (denied/timeout/\nunavailable/unsupported/invalid)\n+ Retry button"
            },
            {
              "_type": "UMLAction",
              "_id": "f0bbf50249b19db423e7ca49802b153d",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "GET /api/nearby (progressive search\n1 -> 2.5 -> 5 km; haversine distance\n2 dp; source OSM; NEVER stored)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "8643c8fc7ebd15db4a961dc58b791445",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Empty even at 5 km?"
            },
            {
              "_type": "UMLAction",
              "_id": "6b2eb51219557af28171c20855d809ae",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Honest empty-state copy (5 km radius\nmention only) - no invented list"
            },
            {
              "_type": "UMLAction",
              "_id": "e3c25f32f1544a850e5a2768da59b4d0",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Cards: name, distance, phone,\naddress, directions + attribution +\nRefresh / Clear location"
            },
            {
              "_type": "UMLAction",
              "_id": "628ae8b060fec05f21d19a4991ce8986",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Rescue teams: GET /api/rescue-teams\n?teamType&search (active only); cards:\nname, type badge, Call team (tel),\nView location, specialization"
            },
            {
              "_type": "UMLAction",
              "_id": "c80e9264fa2b6ba804e3af60ce8367e9",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Emergency facilities: GET /api/facilities\n?facilityType&search (operational only);\ncards: name, type, phone, capacity,\noperating hours"
            },
            {
              "_type": "UMLAction",
              "_id": "f5b865b0dbcdf39a0710821a2490d856",
              "_parent": {
                "$ref": "f87718e1674cbfdb3c392a5becd541f1"
              },
              "name": "Reference-data disclaimer: never\nclaims dispatch, availability, ETA\nor guaranteed response"
            },
