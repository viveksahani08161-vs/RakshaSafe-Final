              "_type": "UMLAction",
              "_id": "ddafe8167f01723b7a72e4e579145d26",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "History timeline oldest first; empty\n=> 'No updates yet' + 'About response'\ninfo alert (no guaranteed response)"
            },
