                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Start"
            },
            {
              "_type": "UMLAction",
              "_id": "d1d233690c5729bf9fcfd9c8a802c228",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Open /#/incident/:id\n3 parallel requests: GET /incidents/:id\n+ /updates + /risk"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "7088ccb3fb85e0f7261a85145bd9b32f",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Incident 404?"
            },
            {
              "_type": "UMLAction",
              "_id": "05a906d8b1aa77e7411f9735d6d6942d",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "'Incident not found': 'This incident\ndoes not exist or is not yours.'"
            },
            {
              "_type": "UMLAction",
              "_id": "2016c003c139d0f69df771c04574a896",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Summary panel: Type / Priority /\nDescription / Reported / Resolved\n(only if resolvedAt)"
            },
            {
              "_type": "UMLAction",
              "_id": "bc7100d4940dae899a125f6adbd0831c",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Location panel or 'No location was\ncaptured for this incident.' +\nLocationEnrichment (reverse address +\nweather) when a location exists"
            },
            {
              "_type": "UMLAction",
              "_id": "8023a8f574abc0fc572059c52ce572d5",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Nearby resources via\nGET /incidents/:id/nearby-resources\n(no location => no-location card)"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "35fbe6e439629f5bdb51c93cd5b24612",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "canManage? status in\nREPORTED/ACKNOWLEDGED\nAND no assignments"
            },
            {
              "_type": "UMLAction",
              "_id": "b18ebdaf13ef171fa2ec301b19c63261",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Edit + Delete shown; Edit modal\n(Type/Category/Description/Priority)\n=> PATCH /incidents/:id"
            },
            {
              "_type": "UMLAction",
              "_id": "0b849ab49446f94805f30c51a3c81d6a",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Edit/Delete hidden + editing-blocked\nalert (server 409: 'Editing/deletion\nis only available for your new,\nunassigned cases...')"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "c84ad532a2e79ff45ee30dc93ccf283f",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Delete confirmed?"
            },
            {
              "_type": "UMLAction",
              "_id": "fa1c4a7cb0b7949473c34209276255f4",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "DELETE /incidents/:id -> toast\n-> back to /#/dashboard\n(no cascading deletes server-side)"
            },
            {
              "_type": "UMLAction",
              "_id": "d1e31d5a58312a7dab03e7052a127375",
              "_parent": {
                "$ref": "e2aeb9aa67fdbe00d4e2e9aae1c91c17"
              },
              "name": "Response assignment card when exists:\nteam name (type), phone tel link,\nAssigned date"
            },
