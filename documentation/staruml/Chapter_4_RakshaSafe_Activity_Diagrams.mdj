                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "Form: category (poorLighting /\nisolatedArea / suspiciousActivity /\nharassmentConcern / unsafeTransport /\nbrokenCCTV / other), severity (low /\nmedium / high / critical), description\n(up to 2000) + live counter"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "9aebdd32005deee22d042f22e0788e5d",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "Location captured?"
            },
            {
              "_type": "UMLAction",
              "_id": "3e1c91242456063a011e789927f1e300",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "Blocked: 'A location is required for\nan unsafe-area report.' - unlike\nincidents, no submit without coords"
            },
            {
              "_type": "UMLAction",
              "_id": "13b8e6f3b94340e2463cf5c16476009f",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "Reverse-geocode lat,lng -> area name;\nhonest fallback: 'Location captured.\nAddress could not be determined.'"
            },
            {
              "_type": "UMLDecisionNode",
              "_id": "c72991351d2c058dbd2add0a3c595e66",
              "_parent": {
                "$ref": "44a2cd93aebd446f5d8cef4619b21e68"
              },
              "name": "Category, severity &\ndescription valid?"
            },
