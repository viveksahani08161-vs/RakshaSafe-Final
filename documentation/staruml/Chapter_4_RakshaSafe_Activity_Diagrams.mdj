                    "$ref": "5dd62321e928b623bae01eea1c845662"
                  },
                  "stereotypeLabel": {
                    "$ref": "d52aadaad1dc76bfa584867bc98d33b4"
                  },
                  "propertyLabel": {
                    "$ref": "27a64f2191f5c89e10f813354688c6e5"
                  }
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "53417e333f35ccd480ffef8a679624a9",
                  "_parent": {
                    "$ref": "9871dbe366c172c35ecbd8241b54f3a3"
                  },
                  "font": "Arial;11;0",
                  "left": 286.0,
                  "top": 1738.0,
                  "width": 215,
                  "height": 64,
                  "text": "Incident status is decoupled from assignment status:\ncreating an assignment leaves the incident untouched."
                },
                {
                  "_type": "UMLNoteLinkView",
                  "_id": "50e20eb93e1824e27a5b69bfcf14b25f",
                  "_parent": {
                    "$ref": "9871dbe366c172c35ecbd8241b54f3a3"
                  },
                  "font": "Arial;13;0",
                  "head": {
                    "$ref": "8529166001b4c2fca32511e882d72aa4"
                  },
                  "tail": {
                    "$ref": "53417e333f35ccd480ffef8a679624a9"
                  },
                  "points": "298.0:1738.0;442.6:1672.0"
                },
                {
                  "_type": "UMLNoteView",
                  "_id": "a12f02c563b11df0f82da69b90e95e4c",
                  "_parent": {
                    "$ref": "9871dbe366c172c35ecbd8241b54f3a3"
                  },
                  "font": "Arial;11;0",
                  "left": 286.0,
                  "top": 1908.0,
                  "width": 215,
                  "height": 64,
                  "text": "ASSIGNED->... assignment transitions are shared with the\nresponder flow (one ALLOWED_ASSIGNMENT_TRANSITIONS map)."
                },
                {
                  "_type": "UMLNoteLinkView",
                  "_id": "b1704f026d935f8415f35325b9686b9e",
                  "_parent": {
                    "$ref": "9871dbe366c172c35ecbd8241b54f3a3"
