# Frontend environment configuration for RakshaSafe (development)
# Copy to .env and adjust as needed.

# Base URL of the backend REST API (used directly, bypassing the Vite proxy,
# e.g. when the frontend is served separately).
VITE_API_BASE_URL=/api

# Base URL of the AI service (used directly when not going through the proxy).
VITE_AI_SERVICE_URL=/ai

# Vite dev-server proxy targets (same host/domain in development).
VITE_PROXY_TARGET=http://localhost:5000
VITE_AI_PROXY_TARGET=http://localhost:8000